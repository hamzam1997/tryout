# Vertex AI
# Local auth: gcloud auth application-default login
# Cloud Run: attach a service account with roles/aiplatform.user
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Server
PORT=8080
FLASK_DEBUG=1

# Database: Cloud Firestore (initialization can fall back to in-memory only with FLASK_DEBUG=1)
FIRESTORE_DATABASE=(default)

# Models
MODEL_EXTRACTION=gemini-3.8-flash
MODEL_ONBOARDING=gemini-3.8-flash
MODEL_PLANNING=gemini-3.1-pro-preview
MODEL_CODING=gemini-3.1-pro-preview

# Execution sandbox
EXECUTION_TIMEOUT_SECONDS=60

# Set to 1 on the demo deploy to seed demo history into each new workspace
# (or seed one workspace: python seed_history.py <workspace_id>)
SEED_DEMO_DATA=0

# Set to 1 to offer "Continue as evaluator" on the landing page: every click is a new
# evaluator with an empty workspace, no Google or GitHub account needed.
EVALUATOR_LOGIN=0

# Optional: a GitHub token limited to the demo repo (hamzam1997/acme-store, contents and
# pull requests: write), so attempts by users without GitHub (evaluators) open real PRs.
DEMO_GITHUB_TOKEN=

# Session signing and GitHub-token encryption. Required unless FLASK_DEBUG=1
# (debug then uses a random key per run). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# GitHub OAuth app for connecting repositories
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Firebase web config served to the UI (Firebase console -> Project settings -> Your apps).
# FIREBASE_PROJECT_ID falls back to GOOGLE_CLOUD_PROJECT when empty.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
