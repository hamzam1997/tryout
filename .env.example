# Database Settings
DATABASE_PATH=tryout.db

# Model Selection
MODEL_EXTRACTION=gemini-2.5-flash
MODEL_ONBOARDING=gemini-2.5-flash
MODEL_PLANNING=gemini-2.5-pro
MODEL_CODING=gemini-2.5-pro

# Execution Sandbox Settings
EXECUTION_TIMEOUT_SECONDS=60
