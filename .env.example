# Vertex AI
# Local auth: gcloud auth application-default login
# Cloud Run: attach a service account with roles/aiplatform.user
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Server
PORT=8080
FLASK_DEBUG=1

# Database: Cloud Firestore (falls back to in-memory when unreachable)
FIRESTORE_DATABASE=(default)

# Models
MODEL_EXTRACTION=gemini-2.5-flash
MODEL_ONBOARDING=gemini-2.5-flash
MODEL_PLANNING=gemini-2.5-pro
MODEL_CODING=gemini-2.5-pro

# Execution sandbox
EXECUTION_TIMEOUT_SECONDS=60

# Set to 1 on the demo deploy to seed demo history into each new workspace
# (or seed one workspace: python seed_history.py <workspace_id>)
SEED_DEMO_DATA=0

# Session signing and GitHub-token encryption. Required unless FLASK_DEBUG=1
# (debug then uses a random key per run). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# GitHub OAuth app for connecting repositories
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Firebase web config served to the UI (Firebase console -> Project settings -> Your apps).
# FIREBASE_PROJECT_ID falls back to GOOGLE_CLOUD_PROJECT when empty.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
