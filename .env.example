# Vertex AI Configuration
# Gemini is accessed through Vertex AI, billed via Google Cloud.
#
# Setup:
#   1. Enable the Vertex AI API (aiplatform.googleapis.com) on the project
#   2. Authenticate locally:  gcloud auth application-default login
#   In Cloud Run, attach a service account with roles/aiplatform.user instead.
GOOGLE_CLOUD_PROJECT=
# "global" serves both the 2.5 and 3.x model families; regional endpoints
# such as us-central1 do not serve the newer models.
GOOGLE_CLOUD_LOCATION=global

# App Server Configuration
PORT=8080
FLASK_DEBUG=1

# Signs session cookies. Leave blank locally and a random per-process key is
# used; set a real one in deployed environments:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database Settings
DATABASE_PATH=tryout.db

# Model Selection
MODEL_EXTRACTION=gemini-2.5-flash
MODEL_ONBOARDING=gemini-2.5-flash
MODEL_PLANNING=gemini-2.5-pro
MODEL_CODING=gemini-2.5-pro

# Execution Sandbox Settings
EXECUTION_TIMEOUT_SECONDS=60
